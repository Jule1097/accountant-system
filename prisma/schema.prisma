generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String        @unique @db.VarChar(255)
  cuit      String        @unique @db.VarChar(50)
  createdAt DateTime      @default(now()) @db.Timestamptz
  updatedAt DateTime      @updatedAt @db.Timestamptz
  users     UserCompany[]
  clients   Client[]
  suppliers Supplier[]
  vouchers  Voucher[]

  @@map("company")
}

model User {
  id        String        @id @db.Uuid
  email     String        @unique @db.VarChar(255)
  createdAt DateTime      @default(now()) @db.Timestamptz
  updatedAt DateTime      @updatedAt @db.Timestamptz
  companies UserCompany[]
  vouchers  Voucher[]

  @@map("users")
}

model UserCompany {
  userId    String   @db.Uuid
  companyId String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
  @@map("user_company")
}

model Client {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @db.VarChar(255)
  cuit      String    @db.VarChar(50)
  companyId String    @db.Uuid
  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vouchers  Voucher[]

  @@unique([companyId, cuit], name: "companyClientCuitUnique")
  @@map("client")
}

model Supplier {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @db.VarChar(255)
  cuit      String    @db.VarChar(50)
  companyId String    @db.Uuid
  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vouchers  Voucher[]

  @@unique([companyId, cuit], name: "companySupplierCuitUnique")
  @@map("supplier")
}

model VoucherType {
  id       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String    @unique @db.VarChar(100)
  vouchers Voucher[]

  @@map("voucher_type")
}

model VoucherLetter {
  id       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  letter   String    @unique @db.VarChar(10)
  vouchers Voucher[]

  @@map("voucher_letter")
}

model RetentionConcept {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String             @unique @db.VarChar(255)
  type       String             @db.VarChar(20)
  retentions VoucherRetention[]

  @@map("retention_concept")
}

model PerceptionConcept {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String              @unique @db.VarChar(255)
  perceptions VoucherPerception[]

  @@map("perception_concept")
}

model TaxJurisdiction {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String              @unique @db.VarChar(100)
  retentions  VoucherRetention[]
  perceptions VoucherPerception[]

  @@map("tax_jurisdiction")
}

model VatRate {
  id      String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name    String             @unique @db.VarChar(50)
  rate    Decimal            @db.Decimal(5, 4)
  details VoucherVatDetail[]

  @@map("vat_rate")
}

model Voucher {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId        String              @db.Uuid
  type             String              @db.VarChar(20)
  voucherTypeId    String              @db.Uuid
  voucherLetterId  String              @db.Uuid
  posNumber        String              @db.VarChar(5)
  number           String              @db.VarChar(8)
  clientId         String?             @db.Uuid
  supplierId       String?             @db.Uuid
  date             DateTime            @db.Date
  accountingPeriod DateTime            @db.Date
  currency         String              @db.VarChar(10)
  exchangeRate     Decimal             @default(1.0000) @db.Decimal(12, 4)
  subtotal         Decimal             @db.Decimal(15, 2)
  vatAmount        Decimal             @db.Decimal(15, 2)
  nonTaxableAmount Decimal             @default(0.00) @db.Decimal(15, 2)
  exemptAmount     Decimal             @default(0.00) @db.Decimal(15, 2)
  otherTaxesAmount Decimal             @default(0.00) @db.Decimal(15, 2)
  totalAmount      Decimal             @db.Decimal(15, 2)
  netAmount        Decimal             @db.Decimal(15, 2)
  concept          String?             @db.Text
  paymentMethod    String              @db.VarChar(100)
  status           String              @db.VarChar(20)
  paymentDate      DateTime?           @db.Date
  paidAmount       Decimal             @default(0.00) @db.Decimal(15, 2)
  comments         String?             @db.Text
  createdByUserId  String              @db.Uuid
  createdAt        DateTime            @default(now()) @db.Timestamptz
  updatedAt        DateTime            @updatedAt @db.Timestamptz
  company          Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  voucherType      VoucherType         @relation(fields: [voucherTypeId], references: [id])
  voucherLetter    VoucherLetter       @relation(fields: [voucherLetterId], references: [id])
  client           Client?             @relation(fields: [clientId], references: [id])
  supplier         Supplier?           @relation(fields: [supplierId], references: [id])
  createdByUser    User                @relation(fields: [createdByUserId], references: [id])
  retentions       VoucherRetention[]
  perceptions      VoucherPerception[]
  vatDetails       VoucherVatDetail[]

  @@map("voucher")
}

model VoucherRetention {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  voucherId          String           @db.Uuid
  retentionConceptId String           @db.Uuid
  taxJurisdictionId  String?          @db.Uuid
  amount             Decimal          @db.Decimal(15, 2)
  voucher            Voucher          @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  retentionConcept   RetentionConcept @relation(fields: [retentionConceptId], references: [id])
  taxJurisdiction    TaxJurisdiction? @relation(fields: [taxJurisdictionId], references: [id])

  @@map("voucher_retention")
}

model VoucherPerception {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  voucherId           String            @db.Uuid
  perceptionConceptId String            @db.Uuid
  taxJurisdictionId   String?           @db.Uuid
  amount              Decimal           @db.Decimal(15, 2)
  voucher             Voucher           @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  perceptionConcept   PerceptionConcept @relation(fields: [perceptionConceptId], references: [id])
  taxJurisdiction     TaxJurisdiction?  @relation(fields: [taxJurisdictionId], references: [id])

  @@map("voucher_perception")
}

model VoucherVatDetail {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  voucherId String  @db.Uuid
  vatRateId String  @db.Uuid
  subtotal  Decimal @db.Decimal(15, 2)
  vatAmount Decimal @db.Decimal(15, 2)
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  vatRate   VatRate @relation(fields: [vatRateId], references: [id])

  @@map("voucher_vat_detail")
}
